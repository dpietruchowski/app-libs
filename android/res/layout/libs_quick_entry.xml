<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingBottom="4dp"
    android:paddingTop="4dp">

    <TextView
        android:id="@+id/libs_quick_entry_minus"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1"
        android:background="@drawable/libs_quick_entry_button"
        android:gravity="center"
        android:text="&#x2212;"
        android:textAppearance="@android:style/TextAppearance.Material.Notification"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/libs_quick_entry_value"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:layout_weight="2.4"
        android:background="@drawable/libs_quick_entry_button"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="@android:style/TextAppearance.Material.Notification"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/libs_quick_entry_plus"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:background="@drawable/libs_quick_entry_button"
        android:gravity="center"
        android:text="+"
        android:textAppearance="@android:style/TextAppearance.Material.Notification"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/libs_quick_entry_variant"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:layout_weight="1.6"
        android:background="@drawable/libs_quick_entry_button"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="@android:style/TextAppearance.Material.Notification"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/libs_quick_entry_mode"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:layout_weight="2"
        android:background="@drawable/libs_quick_entry_button"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="@android:style/TextAppearance.Material.Notification"
        android:textSize="13sp" />
</LinearLayout>
